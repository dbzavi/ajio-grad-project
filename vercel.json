{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "mvp/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**",
      "use": "@vercel/static"
    },
    {
      "src": "mvp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/app.py"
    },
    {
      "src": "/api/predict_fit",
      "dest": "/app.py"
    },
    {
      "src": "/api/predict",
      "dest": "/mvp/api/index.py"
    },
    {
      "src": "/mvp/(.*)",
      "dest": "/mvp/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/$1"
    }
  ]
}
