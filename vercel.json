{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "mvp/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/app.py"
    },
    {
      "src": "/api/predict_fit",
      "dest": "/app.py"
    },
    {
      "src": "/api/predict",
      "dest": "/mvp/api/index.py"
    },
    {
      "src": "/mvp/",
      "dest": "/mvp/index.html"
    },
    {
      "src": "/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
